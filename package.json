{
  "name": "framecheck-free-trial",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-pwa.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src scripts vite.config.ts vitest.config.ts",
    "preview": "vite preview",
    "questions:check": "node scripts/export-question-bank.mjs --check",
    "questions:export": "node scripts/export-question-bank.mjs",
    "scan:public": "node scripts/scan-public-boundary.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run questions:check && npm run scan:public && npm run build"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "29.0.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vite": "7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "4.118.0"
  }
}
