{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "framecheck-free-trial",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "framecheck.devthomas.site",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
